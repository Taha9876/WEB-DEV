DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/relay
APP_URL=http://localhost:3000
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Google Cloud OAuth client (platform-level app; each employee connects their own account)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional, free: enables Relay AI + the assistant chatbot (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional, free: real email delivery for reports (e.g. Gmail app password). Without it, a test inbox is used.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
